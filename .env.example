# HieuTrienEducation — environment configuration
#
# Copy to .env and adjust. Every value here has a working default, so the stack runs without a
# .env file at all; this file documents what can be changed.

# ---------------------------------------------------------------------------- core
ENVIRONMENT=development
DEBUG=true

# Change this before any deployment. Tokens signed with the default are trivially forgeable.
SECRET_KEY=dev-only-insecure-secret-change-me

# ---------------------------------------------------------------------------- database
# Omit entirely to use the zero-setup SQLite file at ./data/hietedu.db.
# Docker Compose sets this to the postgres service automatically.
# DATABASE_URL=postgresql+psycopg://hietedu:hietedu-dev-password@localhost:5432/hietedu
POSTGRES_PASSWORD=hietedu-dev-password
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------- cache
# Optional. The API degrades to an in-process cache when this is unset or unreachable.
# REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ---------------------------------------------------------------------------- ports
API_PORT=8000
WEB_PORT=3000
# The web dev server falls back to this if 3000 is taken: `PORT=3100 npm run dev`
# PORT=3000

# ---------------------------------------------------------------------------- web
# Must be an address the *browser* can reach. Inlined at build time for the Docker image.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=https://hietrieneducation.vn

# ---------------------------------------------------------------------------- CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100

# ---------------------------------------------------------------------------- AI Assist
# Deliberately disabled. Model integration is a later phase of the project; the interfaces,
# database schema and UI are already in place. 'echo' is an offline test stub, not an AI.
AI_PROVIDER=disabled
# AI_API_KEY=
# AI_MODEL=

# ---------------------------------------------------------------------------- live classes
# 'manual' means a teacher pastes the meeting link — this fully works.
# 'zoom' activates the Server-to-Server OAuth integration once all three values are set.
LIVE_CLASS_PROVIDER=manual
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# ---------------------------------------------------------------------------- payments
# 'manual' = bank transfer or cash at the centre, reconciled by an admin. This is how the
# centre operates today. No online gateway is implemented.
PAYMENT_PROVIDER=manual

# ---------------------------------------------------------------------------- video storage
# local | s3 | r2 | external. Only URL resolution is implemented; there is no upload endpoint.
STORAGE_PROVIDER=local
# STORAGE_BUCKET=
# STORAGE_PUBLIC_BASE_URL=https://media.hietrieneducation.vn

# ---------------------------------------------------------------------------- GeoGebra
# GeoGebra's licence restricts its materials to non-commercial use. Enabling this on a platform
# that charges course fees requires a commercial licence agreement with GeoGebra first.
# See docs/OPEN_SOURCE_RESEARCH.md.
GEOGEBRA_ENABLED=false

# ---------------------------------------------------------------------------- testing
# Point Playwright at an already-running dev server instead of letting it start one.
# E2E_BASE_URL=http://127.0.0.1:3000
