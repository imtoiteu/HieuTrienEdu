{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@hietedu/ui": ["../../packages/ui/src/index.ts"],
      "@hietedu/ui/*": ["../../packages/ui/src/*"],
      "@hietedu/curriculum": ["../../packages/curriculum/src/index.ts"],
      "@hietedu/exercise-engine": ["../../packages/exercise-engine/src/index.ts"],
      "@hietedu/localization": ["../../packages/localization/src/index.ts"],
      "@hietedu/analytics": ["../../packages/analytics/src/index.ts"],
      "@hietedu/ai": ["../../packages/ai/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "//exclude": "Playwright's config and specs are test tooling, not application code. They are excluded so `next build` does not require @playwright/test to be installed — a production image should not carry a browser-automation framework. Playwright typechecks both itself when it runs.",
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
